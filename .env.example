# ---- Job applications: POST /api/v1/job-applications (BACKEND_PLAN.md §8) ----

# HR receives every job application here
HR_EMAIL=hrd@spineor.com

# How mail is sent: smtp | brevo | resend
# Render (and most PaaS) block outbound SMTP ports 25/465/587, so use brevo or resend in production.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
RESEND_API_KEY=

# SMTP account (EMAIL_PROVIDER=smtp, local dev only)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=no-reply@spineor.com
SMTP_PASSWORD=your-app-password
# false = STARTTLS on 587, true = implicit TLS on 465
SMTP_SECURE=false

# What HR sees in the From field. Reply-To is set per request to the candidate's email.
EMAIL_FROM="Spineor Careers <no-reply@spineor.com>"

# 4 MB (Vercel rejects request bodies over 4.5 MB)
MAX_RESUME_SIZE_BYTES=4194304
TEMP_UPLOAD_DIR=/tmp/spineor-resumes

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://spineortechnologies.com,https://www.spineortechnologies.com

RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_REQUESTS=5

# Job source of truth (§3). Empty ACTIVE_JOB_IDS = accept any positive job_id and trust job_title.
# ACTIVE_JOB_IDS=101,102,103
# CLOSED_JOB_IDS=100
# JOBS_JSON={"101":"Backend Engineer","102":"Frontend Engineer"}

# ---- Legacy /api/candidates ----
DATABASE_URL=sqlite:///./candidates.db
